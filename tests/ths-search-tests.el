;;; ths-search-tests.el --- Online stock suggestions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths-search)

;; Model the optional frontend's dynamic variables without loading it.
(defvar vertico-mode)
(defvar vertico--input)
(defvar vertico--candidates-ov)

(defconst ths-search-test-response
  "{\"result\":[{\"code\":\"600519\",\"shortName\":\"贵州茅台\",\"securityTypeName\":\"沪A\",\"pinyin\":\"GZMT\"},{\"code\":\"000001\",\"shortName\":\"平安银行\",\"securityTypeName\":\"深A\"},{\"code\":\"920001\",\"shortName\":\"测试北交股\",\"securityTypeName\":\"京A\"},{\"code\":\"600519\",\"shortName\":\"贵州茅台\",\"securityTypeName\":\"沪A\"},{\"code\":\"000001\",\"shortName\":\"上证指数\",\"securityTypeName\":\"指数\"},{\"code\":\"510300\",\"shortName\":\"沪深300ETF\",\"securityTypeName\":\"基金\"}]}")
;; 港股 / 美股样本不放进上面这份 A 股夹具：港美映射由 ths-hkus-tests.el 的
;; 独立样本覆盖，本文件既有断言只描述 A 股与场内基金的行为。

(ert-deftest ths-search-parser-keeps-unique-mainland-stocks-and-listed-funds ()
  (let ((rows (ths-data--search-parse ths-search-test-response)))
    (should (equal '("sh600519" "sz000001" "bj920001" "sh510300")
                   (mapcar (lambda (s) (plist-get s :symbol)) rows)))
    (should (equal "贵州茅台" (plist-get (car rows) :name)))
    (should (equal "GZMT" (plist-get (car rows) :pinyin))))
  (should-not (ths-data--search-parse "{\"result\":[]}"))
  (dolist (text '("<html>error</html>" "{}" "{\"result\":1}"
                  "{\"result\":[{\"code\":\"bad\",\"shortName\":\"错误\",\"securityTypeName\":\"沪A\"}]}"))
    (should-error (ths-data--search-parse text))))

(ert-deftest ths-search-request-encodes-query-and-propagates-errors ()
  (let (url result failure callback)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (address provider cb)
                 (should (eq provider 'eastmoney))
                 (setq url address callback cb) #'ignore)))
      (ths-data--stock-search "贵州&银行" (lambda (rows err) (setq result rows failure err)))
      (should (string-match-p "keyword=%E8%B4%B5%E5%B7%9E%26%E9%93%B6%E8%A1%8C" url))
      (funcall callback ths-search-test-response nil)
      (should (= 4 (length result)))
      (should-not failure)
      (funcall callback "{}" nil)
      (should failure)
      (should-not result)
      (funcall callback nil "offline")
      (should (equal "offline" failure)))))

(ert-deftest ths-search-funds-require-trading-code-and-compatible-market ()
  (let* ((text (json-serialize
                `((result . ,(vconcat
                              (mapcar (lambda (pair)
                                        `((code . ,(car pair)) (shortName . "测试基金")
                                          (securityTypeName . ,(cdr pair))))
                                      '(("510300" . "沪基") ("159915" . "深基")
                                        ("501018" . "LOF") ("161725" . "基金")
                                        ("510300" . "ETF") ; Duplicate trading venue.
                                        ("005827" . "基金") ; Off-exchange NAV code.
                                        ("510300" . "指数")
                                        ("159915" . "沪基")
                                        ("161725" . "场外基金")
                                        ("110001" . "债券"))))))))
         (rows (ths-data--search-parse text)))
    (should (equal '("sh510300" "sz159915" "sh501018" "sz161725")
                   (mapcar (lambda (row) (plist-get row :symbol)) rows)))
    (should (cl-every #'ths-data-fund-p rows))
    (should (equal '("沪基" "深基" "沪基" "深基")
                   (mapcar (lambda (row) (plist-get row :market-label)) rows)))
    ;; 港股映射另用独立样本断言，避免把港美 symbol 混入上面的基金断言。
    (should (equal '("hk00700")
                   (mapcar (lambda (row) (plist-get row :symbol))
                           (ths-data--search-parse
                            (concat "{\"result\":[{\"code\":\"00700\",\"shortName\":\"腾讯控股\","
                                    "\"securityTypeName\":\"港股\"}]}")))))))

(ert-deftest ths-search-debounces-edits-and-keeps-completed-labels ()
  (let ((session (ths-search--create :local (ths-data--search-parse ths-search-test-response))))
    (unwind-protect
        (progn
          (ths-search--update session "")
          (should-not (ths-search--session-timer session))
          (ths-search--update session "贵州")
          (let ((timer (ths-search--session-timer session)) (generation (ths-search--session-generation session)))
            (should (timerp timer))
            (ths-search--update session "贵州")
            (should (eq timer (ths-search--session-timer session)))
            (ths-search--update session (downcase (caar (ths-search--session-labels session))))
            (should (= generation (ths-search--session-generation session)))
            (ths-search--update session "平安")
            (should-not (memq timer timer-idle-list))
            (should (equal "sz000001" (plist-get (car (ths-search--session-rows session)) :symbol)))))
      (ths-search--close session))))

(ert-deftest ths-search-stale-responses-and-closed-sessions-cannot-replace-results ()
  (let ((session (ths-search--create)) callbacks cancelled)
    (unwind-protect
        (cl-letf (((symbol-function 'ths-data-search)
                   (lambda (query cb)
                     (push (cons query cb) callbacks)
                     (lambda () (push query cancelled)))))
          (ths-search--update session "贵州")
          (ths-search--request session "贵州" (ths-search--session-generation session))
          (ths-search--update session "平安")
          (should (member "贵州" cancelled))
          (ths-search--request session "平安" (ths-search--session-generation session))
          (funcall (cdr (assoc "贵州" callbacks)) '((:symbol "sh600519" :name "贵州茅台")) nil)
          (should-not (ths-search--session-rows session))
          (funcall (cdr (assoc "平安" callbacks)) '((:symbol "sz000001" :name "平安银行")) nil)
          (should (equal "sz000001" (plist-get (car (ths-search--session-rows session)) :symbol)))
          (ths-search--update session "银行")
          (ths-search--request session "银行" (ths-search--session-generation session))
          (ths-search--close session)
          (should (member "银行" cancelled))
          (funcall (cdr (assoc "银行" callbacks)) '((:symbol "sh600036" :name "招商银行")) nil)
          (should-not (ths-search--session-rows session)))
      (ths-search--close session))))

(ert-deftest ths-search-failure-keeps-local-candidates-and-accepts-explicit-codes ()
  (let* ((session (ths-search--create :local (ths-data--search-parse ths-search-test-response)))
         (completion-styles '(substring basic))
         (table (lambda (string pred action) (ths-search--table session string pred action))))
    (unwind-protect
        (cl-letf (((symbol-function 'ths-data-search)
                   (lambda (_query cb) (funcall cb nil "offline") #'ignore)))
          (ths-search--update session "贵州")
          (ths-search--request session "贵州" (ths-search--session-generation session))
          (should (string-match-p "在线搜索失败" (ths-search--session-status session)))
          (should (string-match-p "贵州茅台" (car (completion-all-completions "贵州" table nil 2))))
          (should (test-completion "000001" table))
          (should (test-completion "sz000001" table))
          (should-not (test-completion "随便输入" table)))
      (ths-search--close session))))
(ert-deftest ths-search-close-removes-minibuffer-hooks-overlay-and-timer ()
  (with-temp-buffer
    (let ((session (ths-search--create :buffer (current-buffer))))
      (setq-local ths-search--current session)
      (add-hook 'post-command-hook #'ths-search--changed nil t)
      (setf (ths-search--session-overlay session) (make-overlay (point-min) (point-max)))
      (ths-search--update session "银行")
      (let ((timer (ths-search--session-timer session)))
        (ths-search--close session)
        (should-not (memq timer timer-idle-list))
        (should-not (memq #'ths-search--changed post-command-hook))
        (should-not (overlay-buffer (ths-search--session-overlay session)))
        (should-not ths-search--current)))))
(ert-deftest ths-search-vertico-refreshes-without-opening-native-completions ()
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (let ((vertico-mode t)
            (session (ths-search--create :buffer (current-buffer) :status "搜索中…"))
            (refreshes 0))
        (setq-local vertico--candidates-ov nil)
        (cl-letf (((symbol-function 'active-minibuffer-window) #'selected-window)
                  ((symbol-function 'minibuffer-completion-help)
                   (lambda (&rest _) (ert-fail "Opened native completions with Vertico")))
                  ((symbol-function 'display-buffer)
                   (lambda (&rest _) (ert-fail "Opened an extra completion window")))
                  ((symbol-function 'vertico--exhibit)
                   (lambda ()
                     (should (eq t vertico--input))
                     (cl-incf refreshes)
                     (setq-local vertico--input '("茅台" . 2)))))
          ;; THS's setup hook can run before Vertico initializes its overlays.
          (ths-search--notify session)
          (should (= 0 refreshes))
          (setq-local vertico--candidates-ov (make-overlay (point-min) (point-max)))
          (ths-search--notify session)
          ;; Async results and an empty/error response must both refresh the
          ;; existing frontend, even when the input has not changed.
          (ths-search--set-rows session '((:symbol "sh600519" :name "贵州茅台")))
          (ths-search--notify session)
          (ths-search--set-rows session nil)
          (setf (ths-search--session-status session) "在线搜索失败")
          (ths-search--notify session)
          (should (= 3 refreshes)))))))

(ert-deftest ths-search-vanilla-emacs-still-shows-completions ()
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (let ((vertico-mode nil)
            (session (ths-search--create :buffer (current-buffer) :status "候选"))
            shown)
        (ths-search--set-rows session '((:symbol "sh600519" :name "贵州茅台")))
        (cl-letf (((symbol-function 'active-minibuffer-window) #'selected-window)
                  ((symbol-function 'minibuffer-completion-help)
                   (lambda () (setq shown t)))
                  ((symbol-function 'vertico--exhibit)
                   (lambda () (ert-fail "Refreshed disabled Vertico"))))
          (ths-search--notify session)
          (should shown))))))

(ert-deftest ths-search-setup-preserves-vertico-navigation ()
  (dolist (enabled '(t nil))
    (with-temp-buffer
      (let ((vertico-mode enabled)
            (session (ths-search--create))
            (map (make-sparse-keymap)))
        (define-key map (kbd "<down>") 'vertico-next)
        (define-key map (kbd "<up>") 'vertico-previous)
        (use-local-map map)
        (unwind-protect
            (cl-letf (((symbol-function 'ths-search--changed) #'ignore))
              (ths-search--setup session)
              (if enabled
                  (should (eq map (current-local-map)))
                (should-not (eq map (current-local-map))))
              (should (eq (lookup-key (current-local-map) (kbd "<down>"))
                          (if enabled 'vertico-next 'minibuffer-next-completion)))
              (should (eq (lookup-key (current-local-map) (kbd "<up>"))
                          (if enabled 'vertico-previous 'minibuffer-previous-completion))))
          (ths-search--close session))))))

;;; ths-volume-tests.el --- Chart volume regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)
(require 'xml)

(defun ths-volume-test-panel (svg)
  "Parse the volume group in SVG."
  (with-temp-buffer
    (insert svg)
    (let* ((root (car (xml-parse-region (point-min) (point-max))))
           (group (car (xml-get-children root 'g))))
      (should (equal (xml-get-attribute root 'height) "340"))
      (seq-find (lambda (g) (equal (xml-get-attribute g 'id) "volume-panel"))
                (xml-get-children group 'g)))))

(ert-deftest ths-volume-parses-provider-lots-and-converts-only-tencent-cumulative ()
  (let* ((tx (ths-data--chart ths-test-tencent-minute "sz300033" 'tencent 'intraday))
         (em (ths-data--chart ths-test-eastmoney-minute "sz300033" 'eastmoney 'intraday))
         (volumes (lambda (stock) (mapcar (lambda (p) (plist-get p :volume)) (plist-get stock :points)))))
    ;; Auction is included at 09:30.  The fixture jumps from 09:31 to 10:30,
    ;; so that difference cannot be represented as one minute's volume.
    (should (equal '(100 200 nil) (funcall volumes tx)))
    (should (equal '(100 200) (funcall volumes em)))))

(ert-deftest ths-volume-cumulative-gaps-missing-values-and-resets-stay-unknown ()
  (let* ((points (cl-loop for slot in '(0 1 2 3 4 5 6 7 120 120 121)
                          for volume in '(100 100 nil 200 20 30 -1 40 100 110 120)
                          collect (list :slot slot :volume (ths-data--volume volume))))
         (converted (ths-data--minute-volumes points)))
    (should (equal '(100 0 nil nil nil 10 nil nil nil 10 10)
                   (mapcar (lambda (p) (plist-get p :volume)) converted))))
  (should-not (plist-get (car (ths-data--minute-volumes '((:slot 60 :volume 10000)))) :volume)))

(ert-deftest ths-volume-missing-daily-volume-keeps-prices-and-real-zero ()
  (dolist (value '(nil "-" "garbage" -1 "0" "100.5"))
    (let ((candle (ths-data--candle "2026-10-16" "10" "11" "12" "9" value)))
      (should (= 11 (plist-get candle :close)))
      (should (equal (plist-get candle :volume)
                     (cond ((equal value "0") 0) ((equal value "100.5") 100.5)))))))

(ert-deftest ths-volume-intraday-svg-shares-time-axis-and-keeps-zero-and-missing ()
  (let* ((stock '(:intraday-close 10
                 :points ((:time "09:30" :slot 0 :price 11 :volume 10)
                          (:time "10:30" :slot 60 :price 10 :volume 20)
                          (:time "11:30" :slot 120 :price 11 :volume nil)
                          (:time "14:00" :slot 180 :price 11 :volume 0)
                          (:time "15:00" :slot 240 :price 12 :volume 40))))
         (panel (ths-volume-test-panel (ths-chart-svg stock)))
         (bars (xml-get-children panel 'rect)))
    (should (= 4 (length bars)))
    (should (equal '("10" "20" "0" "40") (mapcar (lambda (bar) (xml-get-attribute bar 'data-volume)) bars)))
    (should (equal '("12.00" "24.00" "0.00" "48.00")
                   (mapcar (lambda (bar) (xml-get-attribute bar 'height)) bars)))
    (should (equal (ths-theme-color 'down) (xml-get-attribute (nth 1 bars) 'fill)))
    (should (equal "211.10" (xml-get-attribute (nth 1 bars) 'x)))
    (dolist (bar bars)
      (let ((x (string-to-number (xml-get-attribute bar 'x)))
            (y (string-to-number (xml-get-attribute bar 'y)))
            (width (string-to-number (xml-get-attribute bar 'width)))
            (height (string-to-number (xml-get-attribute bar 'height))))
        (should (<= 68 x (+ x width) 644))
        (should (<= 246 y (+ y height) 294))))))

(ert-deftest ths-volume-daily-bars-align-with-candles-and-visible-range ()
  (let* ((candles '((:date "old" :open 10 :close 11 :high 12 :low 9 :volume 99999)
                    (:date "up" :open 10 :close 11 :high 12 :low 9 :volume 100)
                    (:date "down" :open 11 :close 10 :high 12 :low 9 :volume 200)))
         (panel (ths-volume-test-panel (ths-chart-candles-svg (list :candles candles) 2)))
         (bars (xml-get-children panel 'rect))
         (group (ths-test-daily-svg-group candles 2))
         (bodies (seq-filter (lambda (g) (equal (xml-get-attribute g 'class) "candle"))
                            (xml-get-children group 'g))))
    (should (= 2 (length bars)))
    (should (equal '("24.00" "48.00") (mapcar (lambda (bar) (xml-get-attribute bar 'height)) bars)))
    (cl-loop for bar in bars for candle in bodies
             for body = (car (xml-get-children candle 'rect))
             do (dolist (attribute '(x width fill))
                  (should (equal (xml-get-attribute bar attribute) (xml-get-attribute body attribute)))))))

(ert-deftest ths-volume-empty-and-zero-svg-do-not-invent-bars ()
  (dolist (volume '(nil 0))
    (let* ((stock (list :candles (list (list :open 10 :close 10 :high 10 :low 10 :volume volume))))
           (svg (ths-chart-candles-svg stock))
           (bars (xml-get-children (ths-volume-test-panel svg) 'rect)))
      (if volume
          (progn (should (= 1 (length bars)))
                 (should (equal "0.00" (xml-get-attribute (car bars) 'height)))
                 (should-not (string-match-p "暂无数据" svg)))
        (should-not bars)
        (should (string-match-p "暂无数据" svg))))))

(ert-deftest ths-volume-terminal-charts-preserve-height-and-column-width ()
  (let ((stock (car (ths-test-stocks))))
    (dolist (height '(3 4 5 12 40))
      (dolist (chart (list (ths-chart-line stock 48 height) (ths-chart-candles stock 24 height)))
        (let ((lines (split-string chart "\n")))
          (should (= height (length lines)))
          (should (cl-every (lambda (line) (= 58 (string-width line))) lines)))
        (should (string-match-p (if (>= height 5) "成交量" "量/手") chart))))))

(ert-deftest ths-volume-terminal-aggregates-columns-and-distinguishes-unavailable ()
  (let* ((bars (list (list :x 1 :volume 30 :color (ths-theme-color 'up))
                     (list :x 1 :volume 70 :color (ths-theme-color 'down))))
         (text (ths-chart--volume-text bars 20 2 t)))
    (should (string-match-p "柱峰 100" text))
    (should (equal (get-text-property (string-match "█" text) 'face text)
                   `(:foreground ,(ths-theme-color 'down)))))
  (should (string-match-p "暂无成交量" (ths-chart--volume-text '((:x 0 :volume nil)) 20 2 t)))
  (let ((zero (ths-chart--volume-text '((:x 0 :volume 0)) 20 2 t)))
    (should-not (string-match-p "暂无成交量\\|[▁▂▃▄▅▆▇█]" zero))))

(ert-deftest ths-volume-dashboard-shows-both-panels-without-growing-page ()
  (ths-test-with-dashboard
    (dolist (size '((160 . 60) (80 . 24) (44 . 20)))
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) (car size) (cdr size))
      (ths--section 'detail)
      (dolist (chart '(daily intraday))
        (ths-test-press chart)
        (should (or (ths-test-visible "成交量") (ths-test-visible "量/手")))
        (should (<= (count-lines (point-min) (point-max)) (1- (cdr size))))))))

(ert-deftest ths-fund-prices-render-three-decimals-in-quote-book-trades-and-charts ()
  (ths-test-with-dashboard
    (ths-add-favorite "510300" "测试ETF")
    (let* ((fund (ths-data-find "510300"))
           (values '(:price 1.234 :close 1.230 :high 1.237 :low 1.229
                     :intraday-close 1.230
                     :points ((:time "09:30" :slot 0 :price 1.234 :volume 100)
                              (:time "09:31" :slot 1 :price 1.235 :volume 30))
                     :candles ((:date "2026-10-19" :open 1.231 :close 1.234
                                :high 1.237 :low 1.229 :volume 130))
                     :book (("卖1" 1.235 110 ask) ("买1" 1.233 100 bid))
                     :trades ((:time "09:31:00" :price 1.236 :volume 10 :side buy)))))
      (while values
        (setq fund (plist-put fund (pop values) (pop values))))
      (setq ths-data-stocks (list fund))
      (ths--publish)
      (dolist (text '("1.234" "+0.004" "1.230" "1.237" "1.229" "1.235" "1.233" "1.236"))
        (should (ths-test-visible text)))
      (should (equal "1.23" (ths-data-format-price '(:symbol "sz000001") 1.234)))
      (should (equal "--" (ths-data-format-price fund nil)))
      (dolist (svg (list (ths-chart-svg fund) (ths-chart-candles-svg fund)))
        (should (string-match-p ">1\\.[0-9]\\{3\\}</text>" svg))
        (should (string-match-p "id=\"volume-panel\"" svg)))
      (dolist (chart (list (ths-chart-line fund 48 12) (ths-chart-candles fund 24 12)))
        (should (string-match-p "1\\.[0-9]\\{3\\} │" chart))
        (should (= 12 (length (split-string chart "\n")))))
      (dolist (size '((160 . 60) (80 . 24) (44 . 20)))
        (etaf-runtime-refit (etaf-runtime-for-buffer buffer) (car size) (cdr size))
        (dolist (kind '(daily intraday))
          (ths-test-press kind)
          (should (ths-test-visible "1.234"))
          (should (<= (count-lines (point-min) (point-max)) (1- (cdr size)))))))))

(ert-deftest ths-light-theme-charts-use-light-background-and-legible-trend-colors ()
  (let ((ths-theme 'light) (stock (car (ths-test-stocks))))
    (dolist (svg (list (ths-chart-svg stock) (ths-chart-candles-svg stock)))
      (should (string-match-p "fill=\"#ffffff\"" svg))
      (should (string-match-p "stroke=\"#e0e6ee\"" svg))
      (should (string-match-p "#c62828\\|#087f5b" svg))
      (should-not (string-match-p "#111c2e\\|#ff646e\\|#39d6a0" svg)))
    (let* ((text (ths-chart-line stock 48 12))
           (dot (string-match "●" text))
           (volume (string-match "[▁▂▃▄▅▆▇█]" text)))
      (should dot)
      (should (equal '(:foreground "#1565c0") (get-text-property dot 'face text)))
      (should volume)
      (should (member (plist-get (get-text-property volume 'face text) :foreground)
                      '("#c62828" "#087f5b"))))))


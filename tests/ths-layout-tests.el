;;; ths-layout-tests.el --- Window-height regression checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)

(defun ths-layout-test-fill ()
  "Populate a long watchlist and all recent trades without a network."
  (let ((stock (car ths-data-stocks)))
    (setf (plist-get stock :trades)
          (cl-loop for i below 12 collect
                   (list :time (format "10:00:%02d" (- 59 i)) :price 173.88 :volume 12 :side 'buy))
          (plist-get stock :trades-fetched-at) 1)
    (setq ths-data-stocks
          (append ths-data-stocks
                  (cl-loop for i below 80 collect (ths-data-placeholder (format "sz%06d" (+ 100 i))))))))

(ert-deftest ths-layout-fits-window-height-with-long-lists-and-full-trades ()
  (ths-test-with-dashboard
    (ths-layout-test-fill)
    (dolist (size '((160 . 20) (160 . 24) (136 . 32) (160 . 40) (112 . 24) (80 . 20) (44 . 24)))
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) (car size) (cdr size))
      (dolist (section '(list detail book trades))
        (ths--section section)
        (should (<= (count-lines (point-min) (point-max)) (1- (cdr size))))
        (should (etaf-host-ref-position (etaf-runtime-for-buffer buffer) 'shortcut-j))
        (when (eq section 'book)
          (dolist (label '("卖5" "卖1" "买1" "买5")) (should (ths-test-visible label))))))
    (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 10)
    (should (<= (count-lines (point-min) (point-max)) 9))
    (should (ths-test-visible "窗口太小"))))

(ert-deftest ths-layout-stock-pagination-keeps-selected-stock-visible ()
  (ths-test-with-dashboard
    (ths-layout-test-fill)
    (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
    (ths--section 'list)
    (let ((first (plist-get (etaf-value ths--state) :selected)))
      (ths-next-page)
      (let ((code (plist-get (etaf-value ths--state) :selected)))
        (should-not (equal first code))
        (should (ths-test-visible code)))
      (ths-previous-page)
      (should (equal first (plist-get (etaf-value ths--state) :selected))))
    (dotimes (_ 25)
      (ths-next-stock)
      (should (ths-test-visible (plist-get (etaf-value ths--state) :selected))))))

(ert-deftest ths-layout-ranking-pages-cover-every-row-without-scrolling ()
  (ths-test-with-dashboard
    (let ((rows (cl-loop for i from 1 to 20 collect
                        (list :symbol (format "sz%06d" i) :code (format "%06d" i)
                              :name (format "股票%d" i) :rank i :price 10 :change 1 :volume 100))))
      (puthash '(change . 1) (list :total 21 :rows rows) ths--rankings)
      (puthash '(change . 2) (list :total 21 :rows (list (list :symbol "sz000021" :code "000021" :name "股票21" :rank 21))) ths--rankings)
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
      (ths-show-ranking)
      (dolist (row (seq-take rows (ths--ranking-capacity)))
        (should (ths-test-visible (plist-get row :code))))
      (ths-next-page)
      (dolist (row (seq-drop rows (ths--ranking-capacity)))
        (should (ths-test-visible (plist-get row :code))))
      (should (<= (count-lines (point-min) (point-max)) 23))
      (should (ths-test-visible "下一页 n"))
      (ths-next-page)
      (should (ths-test-visible "000021"))
      (ths-previous-page)
      (should (ths-test-visible "000020"))
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 20)
      (should (<= (count-lines (point-min) (point-max)) 19))
      (should (ths-test-visible "下一页 n"))
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 160 40)
      (dolist (row rows) (should (ths-test-visible (plist-get row :code)))))))
(ert-deftest ths-layout-uses-extra-height-for-chart-and-aligns-panel-bottoms ()
  (ths-test-with-dashboard
    (ths-layout-test-fill)
    (let ((runtime (etaf-runtime-for-buffer buffer)) previous)
      (dolist (height '(40 60 80))
        (etaf-runtime-refit runtime 160 height)
        (let* ((body-height (cdr (etaf-host-ref-size runtime 'dashboard-body)))
               (chart-height (cdr (etaf-host-ref-size runtime 'chart-region)))
               (body-top (line-number-at-pos (etaf-host-ref-position runtime 'dashboard-body)))
               (trades-top (line-number-at-pos (etaf-host-ref-position runtime 'trades-panel)))
               (trades-height (cdr (etaf-host-ref-size runtime 'trades-panel))))
          ;; Growing a window must expand real content, not only the frame.
          (when previous (should (= (- chart-height previous) 20)))
          (setq previous chart-height)
          (should (> chart-height 16))
          (dolist (ref '(watchlist-panel detail-panel))
            (should (= body-height (cdr (etaf-host-ref-size runtime ref)))))
          (should (= (+ body-top body-height) (+ trades-top trades-height)))
          (should (= height (+ body-top body-height)))
          (should (< (etaf-host-ref-position runtime 'shortcut-hint)
                     (etaf-host-ref-position runtime 'dashboard-body)))
          (should (= 2 (cdr (etaf-host-ref-size runtime 'stock-300033)))))
        (should (<= (count-lines (point-min) (point-max)) (1- height)))))
    ;; Missing data still reserves chart space and keeps status at the bottom.
    (setf (plist-get (car ths-data-stocks) :points) nil)
    (ths--publish)
    (should (ths-test-visible "暂无图表数据"))
    (should (> (cdr (etaf-host-ref-size (etaf-runtime-for-buffer buffer) 'chart-region)) 16))))
;;; ths-layout-tests.el ends here

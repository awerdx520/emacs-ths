;;; ths-trades-tests.el --- Recent trade data and UI regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)

(defconst ths-trades-test-response
  "{\"data\":{\"code\":\"300033\",\"details\":[\"10:00:00,173.20,100,1,2\",\"10:00:03,173.15,0.5,2,1\",\"10:00:03,173.15,0.5,1,4\",\"10:00:06,173.18,2,1,9\"]}}")

(ert-deftest ths-trades-parser-preserves-prices-fractional-lots-and-directions ()
  (let ((rows (plist-get (ths-data--trades ths-trades-test-response "sz300033") :trades)))
    (should (= 4 (length rows)))
    (should (equal (mapcar (lambda (s) (plist-get s :time)) rows)
                   '("10:00:06" "10:00:03" "10:00:03" "10:00:00")))
    (should (equal (mapcar (lambda (s) (plist-get s :side)) rows) '(unknown neutral sell buy)))
    (should (= 173.15 (plist-get (nth 1 rows) :price)))
    (should (= 0.5 (plist-get (nth 1 rows) :volume)))))

(ert-deftest ths-trades-parser-keeps-repeated-executions-and-limits-latest-snapshot ()
  (let* ((rows (cl-loop for n below 15 collect (format "10:00:%02d,100,2,1,2" n)))
         (payload (json-serialize `((data . ((code . "300033") (details . ,(vconcat rows))))))))
    (should (= 12 (length (plist-get (ths-data--trades payload "sz300033") :trades))))
    (should (equal "10:00:14" (plist-get (car (plist-get (ths-data--trades payload "sz300033") :trades)) :time))))
  (let ((rows (plist-get (ths-data--trades "{\"data\":{\"details\":[\"10:00:00,100,2,1,2\",\"10:00:00,100,2,1,2\"]}}" "sz300033") :trades)))
    (should (= 2 (length rows)))))

(ert-deftest ths-trades-parser-distinguishes-empty-market-from-bad-data ()
  (should (equal '(:trades nil) (ths-data--trades "{\"data\":{\"details\":[]}}" "sz300033")))
  (dolist (text '("<html>blocked</html>" "{\"data\":null}" "{\"data\":{}}"
                  "{\"data\":{\"code\":\"600519\",\"details\":[]}}"
                  "{\"data\":{\"details\":[\"25:00:00,100,1,1,2\"]}}"
                  "{\"data\":{\"details\":[\"10:00:00,-,1,1,2\"]}}"
                  "{\"data\":{\"details\":[\"10:00:00,100,-5,1,2\"]}}"))
    (should-error (ths-data--trades text "sz300033"))))

(ert-deftest ths-trades-fetch-uses-eastmoney-snapshot-and-explicit-price-units ()
  (let ((ths-data-providers '(tencent sina)) url provider result)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (address source callback)
                 (setq url address provider source)
                 (funcall callback ths-trades-test-response nil)
                 #'ignore)))
      (ths-data-fetch "sz300033" 'trades (lambda (data failure) (should-not failure) (setq result data))))
    (should (eq provider 'eastmoney))
    (should (string-match-p (regexp-quote "details/get?secid=0.300033") url))
    (should (string-match-p "fltt=2" url))
    (should (string-match-p "pos=-12" url))
    (should (= 4 (length (plist-get result :trades))))
    (should (eq 'eastmoney (plist-get result :source)))
    (should (string-match-p "secid=1.600519" (ths-data--url 'eastmoney 'trades "sh600519")))))

(ert-deftest ths-trades-render-below-book-and-remain-with-selected-symbol ()
  (ths-test-with-dashboard
    (let (callbacks)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind cb)
                   (when (eq kind 'trades) (push (cons symbol cb) callbacks)) #'ignore)))
        (ths--fetch "sz300033" 'trades)
        (ths--set ths--state :selected "600519")
        (ths--fetch "sh600519" 'trades)
        (funcall (cdr (assoc "sh600519" callbacks))
                 '(:trades ((:time "10:01:00" :price 1465.20 :volume 25 :side buy)) :source eastmoney :fetched-at 1) nil)
        (funcall (cdr (assoc "sz300033" callbacks))
                 (append (ths-data--trades ths-trades-test-response "sz300033") '(:source eastmoney :fetched-at 1)) nil)
        (should (ths-test-visible "10:01:00"))
        (should-not (ths-test-visible "10:00:06"))
        (should (< (string-match "五档盘口" (buffer-string)) (string-match "成交记录 / 分时成交" (buffer-string))))
        (ths--set ths--state :selected "300033")
        (should (ths-test-visible "10:00:06"))
        (should (ths-test-visible "0.50"))
        (should (ths-test-visible "接口未提供交易日期"))))))

(ert-deftest ths-trades-cache-replaces-snapshots-retains-on-error-clears-on-empty ()
  (ths-test-with-dashboard
    (let (callback)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (_symbol _kind cb) (setq callback cb) #'ignore)))
        (dotimes (_ 2)
          (ths--fetch "sz300033" 'trades)
          (funcall callback (append (ths-data--trades ths-trades-test-response "sz300033")
                                    '(:source eastmoney :fetched-at 1)) nil))
        (should (= 4 (length (plist-get (ths-data-find "300033") :trades))))
        (ths--fetch "sz300033" 'trades)
        (funcall callback nil "network down")
        (should (ths-test-visible "更新失败，保留上次记录"))
        (should (ths-test-visible "10:00:06"))
        (ths--fetch "sz300033" 'trades)
        (funcall callback '(:trades nil :source eastmoney :fetched-at 2) nil)
        (should-not (ths-test-visible "10:00:06"))
        (should (ths-test-visible "暂无成交记录"))
        (should-not (plist-get (ths-data-find "300033") :trades-error))))))

(ert-deftest ths-trades-selection-starts-request-and-close-cancels-it ()
  (ths-test-with-dashboard
    (let ((ths-auto-fetch t) callback calls cancelled)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind cb)
                   (push (cons symbol kind) calls)
                   (when (eq kind 'trades) (setq callback cb))
                   (lambda () (when (eq kind 'trades) (setq cancelled t))))))
        (ths--set ths--state :selected "600519")
        (should (member '("sh600519" . trades) calls))
        (etaf-unmount (etaf-runtime-for-buffer buffer))
        (should cancelled)
        (funcall callback '(:trades ((:time "10:00:00" :price 1 :volume 1 :side buy))) nil)
        (should-not (plist-get (ths-data-find "600519") :trades))))))

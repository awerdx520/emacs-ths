;;; ths-fund-ranking-tests.el --- Categorized ranking regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'ths)

(defun ths-fund-rank-test-data (universe &optional sort page)
  "Build synthetic protocol data for UNIVERSE, SORT and PAGE."
  (let* ((page (or page 1)) (sort (or sort 'change))
         (offset (* (1- page) 20))
         (base (pcase universe ('stock 1) ('etf 510300) ('lof 161725)))
         (market (if (eq universe 'etf) 1 0))
         (rows (cl-loop for i from offset below (min 21 (+ offset 20))
                        collect `((f12 . ,(format "%06d" (+ base i))) (f13 . ,market)
                                  (f14 . ,(format "%s%d" (ths-data-ranking-label universe) i))
                                  (f2 . 1.234) (f18 . 1.230) (f3 . ,(- 10.0 i))
                                  (f5 . ,(+ 100 i)) (f6 . ,(/ 1000000000.0 (1+ i)))))))
    (ths-data--ranking-parse (json-serialize `((data . ((total . 21) (diff . ,(vconcat rows))))))
                             sort page universe)))

(ert-deftest ths-fund-ranking-routes-exact-universe-and-server-sort ()
  (dolist (universe '(stock etf lof))
    (dolist (sort '(change amount))
      (let ((url (ths-data--ranking-url sort 2 nil universe))
            (sina (ths-data--ranking-sina-url sort 2 nil universe)))
        (should (string-match-p "pn=2&pz=20&po=1" url))
        (should (string-match-p (if (eq sort 'change) "fid=f3" "fid=f6") url))
        (should (string-match-p (pcase universe ('stock "fs=m:0") ('etf "fs=b:MK0021") ('lof "fs=b:MK0404")) url))
        (should (string-match-p (pcase universe ('stock "node=hs_a") ('etf "node=etf_hq_fund") ('lof "node=lof_hq_fund")) sina))
        (should (string-match-p "page=2&num=20" sina))
        (should (string-match-p (if (eq sort 'change) "sort=changepercent&asc=0" "sort=amount&asc=0") sina)))))
  (dolist (entry '(("510300" 1 etf "sh510300") ("159915" 0 etf "sz159915")
                    ("501018" 1 lof "sh501018") ("161725" 0 lof "sz161725")))
    (should (equal (nth 3 entry) (apply #'ths-data--ranking-symbol (seq-take entry 3)))))
  (dolist (entry '(("600000" 1 etf) ("510300" 1 lof) ("161725" 0 etf)
                    ("501018" 1 etf) ("159915" 0 lof) ("510300" 0 etf)
                    ("000001" 1 etf) ("005827" 0 lof) ("110001" 1 etf)))
    (should-not (apply #'ths-data--ranking-symbol entry)))
  (should-error (ths-data--ranking-url 'change 1 nil 'unknown))
  (should-error (ths-data-fetch-ranking 'change 1 #'ignore 'unknown)))

(ert-deftest ths-fund-ranking-recognizes-additional-listed-fund-code-ranges ()
  ;; SSE: 530xxx stock ETF, 551xxx bond ETF, 506xxx STAR-board LOF.
  (dolist (entry '(("530080" etf) ("551030" etf) ("551510" etf)
                    ("506000" lof) ("506002" lof)))
    (let* ((code (car entry)) (universe (cadr entry)) (symbol (concat "sh" code))
           (text (format "{\"data\":{\"total\":1,\"diff\":[{\"f12\":\"%s\",\"f13\":1,\"f14\":\"基金\"}]}}" code)))
      (should (equal symbol (ths-data--ranking-symbol code 1 universe)))
      (should (eq universe (plist-get (ths-data--ranking-parse text 'change 1 universe) :universe)))
      (should (equal symbol (ths-watchlist-symbol code)))
      (should (ths-data-fund-p (ths-data-placeholder symbol)))
      (should (equal "1.234" (ths-data-format-price (ths-data-placeholder symbol) 1.234)))
      (should-not (ths-data--ranking-symbol code 1 (if (eq universe 'etf) 'lof 'etf)))
      (should-not (ths-data--ranking-symbol code 1 'stock))))
  ;; REITs and stocks must not be admitted as ETF/LOF.
  (dolist (code '("508000" "600000"))
    (dolist (universe '(etf lof))
      (should-not (ths-data--ranking-symbol code 1 universe)))))

(ert-deftest ths-fund-ranking-parser-preserves-order-and-rejects-mixed-pages ()
  (dolist (universe '(etf lof))
    (let* ((data (ths-fund-rank-test-data universe 'amount 1))
           (rows (plist-get data :rows))
           (first (car rows)) (last (car (last rows))))
      (should (eq universe (plist-get data :universe)))
      (should (= 1.234 (plist-get first :price)))
      (should (> (plist-get first :amount) (plist-get last :amount)))
      (should (< (plist-get first :volume) (plist-get last :volume)))
      (should (= 21 (plist-get (car (plist-get (ths-fund-rank-test-data universe 'amount 2) :rows)) :rank)))))
  (dolist (universe '(stock etf lof))
    (should-error
     (ths-data--ranking-parse
      "{\"data\":{\"total\":2,\"diff\":[{\"f12\":\"510300\",\"f13\":1,\"f14\":\"ETF\"},{\"f12\":\"161725\",\"f13\":0,\"f14\":\"LOF\"}]}}"
      'change 1 universe) :type 'ths-data-ranking-universe-error))
  (should-error
   (ths-data--ranking-parse
    "{\"data\":{\"total\":2,\"diff\":[{\"f12\":\"510300\",\"f13\":1,\"f14\":\"ETF\"},{\"f12\":\"510300\",\"f13\":1,\"f14\":\"ETF\"}]}}"
    'change 1 'etf)))

(ert-deftest ths-fund-ranking-sina-jsonp-objects-and-positional-rows ()
  (dolist (text '("thsFundRank([{symbol:\"sh510300\",name:\"测试ETF\",trade:\"1.234\",volume:\"10000\",amount:\"12340\"}]);"
                  "thsFundRank(\n[[\"sh510300\",\"测试ETF\",\"1.234\",\"0.004\",\"0.33\",\"1.233\",\"1.235\",\"1.230\",\"1.231\",\"1.237\",\"1.229\",\"10000\",\"12340\"]]\n);"))
    (let* ((data (ths-data--ranking-sina-parse text 'change 1 1 'etf))
           (row (car (plist-get data :rows))))
      (should (equal "sh510300" (plist-get row :symbol)))
      (should (equal "测试ETF" (plist-get row :name)))
      (should (= 1.234 (plist-get row :price)))
      (should (= 100 (plist-get row :volume)))
      (should (= 12340 (plist-get row :amount)))
      (should-not (plist-get row :float-cap)))
    (dolist (encoding '(utf-8 gb18030))
      (should (equal text (ths-data--decode (encode-coding-string text encoding) 'sina))))
    (should-error (ths-data--ranking-sina-parse text 'change 1 1 'lof)
                  :type 'ths-data-ranking-universe-error))
  (should-error (ths-data--ranking-sina-parse "otherCallback([]);" 'change 1 1 'etf)))

(ert-deftest ths-fund-ranking-fallback-keeps-category-sort-and-cancellation ()
  (dolist (universe '(etf lof))
    (let ((ths-data-ranking-providers '(eastmoney sina)) calls callback cancelled result)
      (cl-letf (((symbol-function 'ths-data--http)
                 (lambda (url source cb)
                   (push url calls)
                   (cond ((eq source 'eastmoney) (funcall cb "{\"data\":null}" nil))
                         ((string-match-p "StockCount" url) (funcall cb "\"1\"" nil))
                         (t (setq callback cb)))
                   (lambda () (setq cancelled url)))))
        (let ((cancel (ths-data-fetch-ranking 'amount 1 (lambda (data err) (should-not err) (setq result data)) universe)))
          (should (= 4 (length calls)))
          (should (string-match-p "sort=amount&asc=0" (car calls)))
          (should (string-match-p (if (eq universe 'etf) "node=etf_hq_fund" "node=lof_hq_fund") (car calls)))
          (funcall callback (format "/*<script>location.href='//sina.com';</script>*/\nthsFundRank([{symbol:\"%s\",name:\"基金\",trade:\"1.234\",amount:\"100000\"}]);"
                                    (if (eq universe 'etf) "sz159915" "sh501018")) nil)
          (should (eq universe (plist-get result :universe)))
          (should (eq 'sina (plist-get result :source)))
          (funcall cancel)
          (should (equal cancelled (car calls)))
          (let ((before result))
            (funcall callback nil "late")
            (should (eq before result))))))))

(ert-deftest ths-fund-ranking-sina-comment-prefix-decoding-and-strict-wrapper ()
  (dolist (universe '(etf lof))
    (let* ((symbol (if (eq universe 'etf) "sh588790" "sz161725"))
           (payload (format "thsFundRank([{symbol:\"%s\",name:\"测试基金/*保留*/\",trade:\"1.234\"}]);" symbol))
           (text (concat " \n/*<script>location.href='//sina.com';</script>*/\n/* header */\n" payload)))
      (dolist (coding '(utf-8 gb18030))
        (let* ((decoded (ths-data--decode (encode-coding-string text coding) 'sina))
               (data (ths-data--ranking-sina-parse decoded 'change 1 1 universe)))
          (should (equal text decoded))
          (should (equal symbol (plist-get (car (plist-get data :rows)) :symbol)))
          (should (equal "测试基金/*保留*/" (plist-get (car (plist-get data :rows)) :name)))))
      (dolist (invalid (list (concat "/* unterminated " payload)
                             (concat "/* header */alert(1);" payload)
                             (concat "/* header */otherCallback([]);")
                             (concat text "alert(1);")))
        (should-error (ths-data--ranking-sina-parse invalid 'change 1 1 universe))))))

(ert-deftest ths-fund-ranking-remembers-pages-segments-and-selection-per-category ()
  (ths-test-with-dashboard
    (dolist (universe '(stock etf lof))
      (dolist (page '(1 2))
        (puthash (list universe 'amount page)
                 (ths-fund-rank-test-data universe 'amount page) ths--rankings)))
    (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
    (ths--ranking-select ths--state 'amount)
    (dotimes (_ 3) (ths-next-stock))
    (ths-test-press 'rank-etf)
    (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
    (dotimes (_ 21) (ths-next-stock))
    (should (= 2 (plist-get (etaf-value ths--state) :ranking-page)))
    (ths-test-press 'rank-lof)
    (dotimes (_ 18) (ths-next-stock))
    (let ((offset (plist-get (etaf-value ths--state) :ranking-offset))
          (runtime (etaf-runtime-for-buffer buffer)))
      (should (> offset 0))
      (ths-test-press 'rank-etf)
      (should (= 2 (plist-get (etaf-value ths--state) :ranking-page)))
      (should (eq 'rank-sh510320 (etaf-focused-host-ref runtime)))
      (ths-test-press 'rank-lof)
      (should (= offset (plist-get (etaf-value ths--state) :ranking-offset)))
      (should (eq 'rank-sz161742 (etaf-focused-host-ref runtime)))
      (ths-test-press 'rank-stock)
      (should (= 1 (plist-get (etaf-value ths--state) :ranking-page)))
      (should (eq 'rank-sz000003 (etaf-focused-host-ref runtime)))
      (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort))))))

(ert-deftest ths-fund-ranking-late-category-responses-stay-in-own-cache ()
  (ths-test-with-dashboard
    (let ((ths-auto-fetch t) callbacks)
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (sort page cb &optional universe)
                   (should (eq sort 'change)) (should (= page 1))
                   (push (cons universe cb) callbacks) #'ignore)))
        (ths-show-ranking)
        (ths-test-press 'rank-etf)
        (ths-refresh)
        (ths-test-press 'rank-lof)
        (ths-refresh)
        (should (= 3 (length callbacks)))
        (dolist (universe '(lof stock etf))
          (funcall (cdr (assq universe callbacks)) (ths-fund-rank-test-data universe) nil)
          (should (eq 'lof (plist-get (etaf-value ths--state) :ranking-universe)))
          (should (ths-test-visible "LOF0"))
          (should-not (ths-test-visible "ETF0")))
        (should (= 3 (hash-table-count ths--rankings)))
        (should (= 0 (hash-table-count ths--requests)))))))

(ert-deftest ths-fund-ranking-controls-fit-third-row-and-prices-remain-precise ()
  (ths-test-with-dashboard
    (dolist (theme '(dark light))
      (let ((ths-theme theme))
        (dolist (universe '(etf lof))
          (dolist (sort '(change amount))
            (puthash (list universe sort 1) (ths-fund-rank-test-data universe sort) ths--rankings)
            (ths-ranking-set-universe universe)
            (ths--ranking-select ths--state sort)
            (dolist (width '(44 54 79 80 112 160))
              (let ((runtime (etaf-runtime-for-buffer buffer)))
                (etaf-runtime-refit runtime width 24)
                (dolist (ref (append '(rank-stock rank-etf rank-lof)
                                     (when (>= width ths--ranking-hk-us-buttons)
                                       '(rank-hkstock rank-usstock))
                                     '(rank-change rank-amount)))
                  (let ((pos (etaf-host-ref-position runtime ref)))
                    (should pos)
                    (should (= 3 (line-number-at-pos pos)))
                    (save-excursion
                      (goto-char pos)
                      (should (<= (+ (current-column) (car (etaf-host-ref-size runtime ref))) (1- width))))))
                (when (< width ths--ranking-hk-us-buttons)
                  (should-not (etaf-host-ref-position runtime 'rank-hkstock))
                  (should-not (etaf-host-ref-position runtime 'rank-usstock)))
                (should (= 2 (line-number-at-pos (etaf-host-ref-position runtime 'shortcut-u))))
                (should (ths-test-visible "1.234"))
                (should (<= (apply #'+ (mapcar (lambda (field) (nth 2 field))
                                              (ths--ranking-columns width sort universe))) (- width 4)))
                (should (<= (count-lines (point-min) (point-max)) 23))))))))))

(ert-deftest ths-fund-ranking-keyboard-cycle-open-and-return-to-selection ()
  (ths-test-with-dashboard
    (dolist (universe '(stock etf lof))
      (puthash (list universe 'change 1) (ths-fund-rank-test-data universe) ths--rankings))
    (ths-show-ranking)
    (should (eq #'ths-ranking-cycle-universe (key-binding (kbd "u"))))
    (ths-test-press 'shortcut-u)
    (should (eq 'etf (plist-get (etaf-value ths--state) :ranking-universe)))
    (ths-next-stock)
    (ths-next-stock)
    (let ((ths-auto-fetch t) calls)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind _cb) (push (cons symbol kind) calls) #'ignore)))
        (etaf-activate (etaf-runtime-for-buffer buffer))
        (should (equal "510301" (plist-get (etaf-value ths--state) :selected)))
        (should (ths-test-visible "场内基金"))
        (should (ths-test-visible "1.234"))
        (ths-daily)
        (dolist (kind '(quote intraday daily trades))
          (should (member (cons "sh510301" kind) calls)))))
    (ths-toggle-favorite)
    (should (member "510301" (plist-get (etaf-value ths--state) :favorites)))
    (ths-show-ranking)
    (should (eq 'rank-sh510301 (etaf-focused-host-ref (etaf-runtime-for-buffer buffer))))
    (ths-test-press 'shortcut-u)
    (should (eq 'lof (plist-get (etaf-value ths--state) :ranking-universe)))
    (ths-test-press 'shortcut-u)
    (should (eq 'hkstock (plist-get (etaf-value ths--state) :ranking-universe)))
    (ths-test-press 'shortcut-u)
    (should (eq 'usstock (plist-get (etaf-value ths--state) :ranking-universe)))
    (ths-test-press 'shortcut-u)
    (should (eq 'stock (plist-get (etaf-value ths--state) :ranking-universe)))))


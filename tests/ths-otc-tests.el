;;; ths-otc-tests.el --- OTC fund regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)

(defconst ths-otc-test-nav
  (concat "/*基金数据*/var ishb=false;/*名称*/var fS_name=\"测试场外基金\";var fS_code=\"000001\";"
          "var Data_netWorthTrend=[{\"x\":1704067200000,\"y\":1.2,\"equityReturn\":1.5},"
          "{\"x\":1704153600000,\"y\":1.1,\"equityReturn\":0.5,\"unitMoney\":\"分红\"}];"
          "var Data_ACWorthTrend=[[1704067200000,1.3],[1704153600000,1.4]];"))
(defconst ths-otc-test-money
  (concat "var ishb=true;var fS_name=\"测试货币基金\";var fS_code=\"000198\";"
          "var Data_millionCopiesIncome=[[1704067200000,0],[1704153600000,0.2345]];"
          "var Data_sevenDaysYearIncome=[[1704067200000,0.8],[1704153600000,0.81]];"))
(defconst ths-otc-test-search
  "{\"ErrCode\":0,\"Datas\":[{\"CATEGORY\":700,\"CODE\":\"000001\",\"NAME\":\"测试场外基金\",\"JP\":\"CSCWJJ\",\"FundBaseInfo\":{\"FCODE\":\"000001\"}},{\"CATEGORY\":100,\"CODE\":\"000001\",\"NAME\":\"平安银行\"}]}")

(defun ths-otc-test-stock (&optional money)
  "Build an isolated published-data fixture, optionally MONEY."
  (let ((symbol (if money "of000198" "of000001")))
    (append (ths-data--fund-parse (if money ths-otc-test-money ths-otc-test-nav) symbol)
            (ths-data-placeholder symbol) '(:quote-source fund :quote-fetched-at 1))))

(ert-deftest ths-otc-parser-uses-published-return-and-four-decimals ()
  (let ((stock (ths-otc-test-stock)))
    (should (equal (plist-get stock :time) "2024-01-02"))
    (should (= (plist-get stock :price) 1.1))
    (should (= (plist-get stock :acc-nav) 1.4))
    ;; NAV falls on an ex-dividend day, while the published return is positive.
    (should (= (ths-data-change stock) 0.5))
    (should (equal (ths-data-format-price stock 1.1) "1.1000"))
    (should (equal (mapcar (lambda (row) (plist-get row :date)) (plist-get stock :nav-history))
                   '("2024-01-01" "2024-01-02")))
    (should-not (plist-get stock :candles))
    (should-not (plist-get stock :points))))

(ert-deftest ths-otc-parser-rejects-corrupt-mismatched-and-executable-responses ()
  (should-error (ths-data--fund-parse ths-otc-test-nav "of005827"))
  (dolist (text (list "<html>offline</html>"
                     (replace-regexp-in-string "1704153600000" "1704067200000" ths-otc-test-nav)
                     (replace-regexp-in-string "1.1," "null," ths-otc-test-nav t t)
                     (replace-regexp-in-string "false;" "false || alert(1);" ths-otc-test-nav t t)))
    (should-error (ths-data--fund-parse text "of000001")))
  (let ((stock (ths-data--fund-parse
                (replace-regexp-in-string "\\\"equityReturn\\\":0.5" "\"equityReturn\":null" ths-otc-test-nav)
                "of000001")))
    (should-not (plist-get stock :nav-change))))

(ert-deftest ths-otc-money-fund-uses-income-and-yield-without-fake-change ()
  (let ((stock (ths-otc-test-stock t)))
    (should (plist-get stock :money-fund))
    (should (= (plist-get stock :price) 0.2345))
    (should (= (plist-get stock :acc-nav) 0.81))
    (should-not (ths-data-change stock))
    (should (= (plist-get (car (plist-get stock :nav-history)) :nav) 0))))

(ert-deftest ths-otc-search-merges-results-once-and-cancels-both ()
  (let (requests callbacks result failure cancelled count)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (url provider callback)
                 (push url requests) (push (cons provider callback) callbacks)
                 (lambda () (push provider cancelled)))))
      (let ((cancel (ths-data-search "测试&基金" (lambda (rows err)
                                                 (setq result rows failure err count (1+ (or count 0)))))))
        (should (= 2 (length requests)))
        (should (string-match-p "%E6%B5%8B%E8%AF%95%26%E5%9F%BA%E9%87%91" (car requests)))
        (funcall (cdr (assq 'fund callbacks)) ths-otc-test-search nil)
        (should-not count)
        (funcall (cdr (assq 'eastmoney callbacks)) nil "stocks offline")
        (should (= count 1))
        (should-not failure)
        (should (equal (mapcar (lambda (stock) (plist-get stock :symbol)) result) '("of000001")))
        (funcall cancel)
        (should (= (length cancelled) 2))
        (funcall (cdr (assq 'fund callbacks)) ths-otc-test-search nil)
        (should (= count 1))))))

(ert-deftest ths-otc-fetch-uses-fund-source-and-retains-errors ()
  (let (url result failure requests)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (address provider callback)
                 (setq url address requests (1+ (or requests 0)))
                 (should (eq provider 'fund))
                 (funcall callback ths-otc-test-nav nil) #'ignore)))
      (ths-data-fetch "of000001" 'quote (lambda (rows err) (setq result rows failure err)))
      (should (string-match-p "pingzhongdata/000001.js" url))
      (should-not failure)
      (should (eq (plist-get result :source) 'fund))
      (should (= (plist-get result :price) 1.1))
      (dolist (kind '(intraday daily trades))
        (ths-data-fetch "of000001" kind (lambda (rows err) (setq result rows failure err)))
        (should-not result) (should failure))
      (should (= requests 1)))))

(ert-deftest ths-otc-watchlist-coexists-with-same-code-stock-and-persists ()
  (let ((ths-watchlist-file (make-temp-file "ths-otc-watchlist-")))
    (unwind-protect
        (progn
          (ths-watchlist-save nil)
          (ths-test-with-dashboard
            (ths-add-favorite "sz000001" "平安银行")
            (ths-add-favorite "of000001" "测试场外基金")
            (should (ths-data-find "000001"))
            (should (ths-data-find "of000001"))
            (should (equal (ths-watchlist-load) '("sz000001" "of000001")))
            (should (equal (plist-get (etaf-value ths--state) :selected) "of000001"))
            (ths-remove-favorite)
            (should (equal (ths-watchlist-load) '("sz000001")))
            (should (equal (plist-get (etaf-value ths--state) :selected) "000001"))))
      (delete-file ths-watchlist-file))))

(ert-deftest ths-otc-selection-fetches-only-nav-and-throttles-automatic-refresh ()
  (ths-test-with-dashboard
    (setq ths-data-stocks (list (ths-otc-test-stock)) ths-data-indices nil)
    (let ((ths-auto-fetch t) calls)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind callback)
                   (push (cons symbol kind) calls)
                   (funcall callback (list :price 1.1 :fetched-at (float-time)) nil) #'ignore)))
        (ths--set ths--state :selected "of000001")
        (should (equal calls '(("of000001" . quote))))
        (ths-daily) (ths-intraday) (ths-refresh t)
        (should (= (length calls) 1))
        (ths-refresh)
        (should (cl-every (lambda (call) (eq (cdr call) 'quote)) calls))
        (should (> (length calls) 1))))))

(ert-deftest ths-otc-charts-and-panels-fit-both-themes-without-trading-widgets ()
  (ths-test-with-dashboard
    (dolist (money '(nil t))
      (setq ths-data-stocks (list (ths-otc-test-stock money)))
      (ths--set ths--state :selected (ths-data-id (car ths-data-stocks)))
      (dolist (theme '(dark light))
        (let ((ths-theme theme))
          (dolist (size '((160 . 20) (160 . 40) (136 . 32) (80 . 24) (44 . 20)))
            (etaf-runtime-refit (etaf-runtime-for-buffer buffer) (car size) (cdr size))
            (dolist (chart '(intraday daily))
              (ths--set ths--state :chart chart)
              (should (ths-test-visible (if money (if (eq chart 'daily) "七日年化" "万份收益")
                                         (if (eq chart 'daily) "累计净值" "单位净值"))))
              (should (ths-test-visible "2024-01-02"))
              (should-not (ths-test-visible "09:30"))
              (should-not (ths-test-visible "五档盘口"))
              (should-not (ths-test-visible "分时走势"))
              (should (<= (count-lines (point-min) (point-max)) (1- (cdr size)))))))))
    (let ((svg (ths-chart-nav (ths-otc-test-stock) nil 60 20 t)))
      (should (string-match-p "polyline" svg))
      (should (string-match-p "2024-01-02" svg))
      (should-not (string-match-p "volume-panel" svg))
      (with-temp-buffer (insert svg) (should (xml-parse-region (point-min) (point-max)))))))

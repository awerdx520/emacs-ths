;;; ths-ranking-tests.el --- Market ranking regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)

(defconst ths-rank-test-response
  "{\"data\":{\"total\":3,\"diff\":[{\"f12\":\"600000\",\"f13\":1,\"f14\":\"浦发银行\",\"f2\":12,\"f3\":10.0,\"f5\":250000,\"f6\":300000000,\"f21\":10000000000,\"f24\":-12.34,\"f18\":10.91,\"f124\":1792128600},{\"f12\":\"000001\",\"f13\":0,\"f14\":\"平安银行\",\"f2\":10,\"f3\":5.0,\"f5\":500000,\"f6\":500000000,\"f21\":\"5000000000\",\"f24\":\"0\"},{\"f12\":\"920001\",\"f13\":0,\"f14\":\"测试北交股\",\"f2\":\"-\",\"f3\":\"-\",\"f5\":\"-\",\"f6\":\"-\",\"f21\":\"-\",\"f24\":\"-\"}]}}")

(defun ths-rank-test-data (&optional sort page)
  "Return a fresh ranking test snapshot for SORT and PAGE."
  (ths-data--ranking-parse ths-rank-test-response (or sort 'change) (or page 1)))

(defconst ths-rank-test-sina-response
  "[{\"symbol\":\"sh600000\",\"code\":\"600000\",\"name\":\"浦发银行\",\"trade\":\"12.00\",\"changepercent\":\"10\",\"volume\":20000,\"amount\":1000000,\"nmc\":1000000,\"settlement\":\"10.91\",\"turnoverratio\":\"1.5\"},{\"symbol\":\"bj920001\",\"code\":\"920001\",\"name\":\"测试北交股\",\"trade\":\"-\",\"changepercent\":5,\"volume\":100000,\"amount\":500000,\"nmc\":\"-\"}]")

(ert-deftest ths-ranking-sina-normalizes-units-identities-and-unquoted-keys ()
  (let* ((data (ths-data--ranking-sina-parse ths-rank-test-sina-response 'amount 2 22))
         (rows (plist-get data :rows)) (stock (car rows)))
    (should (eq 'sina (plist-get data :source)))
    (should (equal '(21 22) (mapcar (lambda (row) (plist-get row :rank)) rows)))
    (should (equal '("sh600000" "bj920001") (mapcar (lambda (row) (plist-get row :symbol)) rows)))
    (should (= 200 (plist-get stock :volume)))
    (should (= 1000000 (plist-get stock :amount)))
    (should (= 10000000000 (plist-get stock :float-cap)))
    (should (= 10 (plist-get stock :change)))
    (should (= 1.5 (plist-get stock :turnover)))
    (should-not (plist-get stock :change-60d))
    (should-not (plist-get (cadr rows) :price))
    (should-not (plist-get (cadr rows) :float-cap)))
  (let* ((text "[{symbol:\"sz000001\",code:\"000001\",name:\"测试,trade:名称\",trade:\"10\"}]")
         (data (ths-data--ranking-sina-parse text 'change 1 1)))
    (should (equal "测试,trade:名称" (plist-get (car (plist-get data :rows)) :name))))
  (dolist (coding '(utf-8 gb18030))
    (should (equal ths-rank-test-sina-response
                   (ths-data--decode (encode-coding-string ths-rank-test-sina-response coding) 'sina)))))

(ert-deftest ths-ranking-sina-rejects-empty-invalid-and-mixed-responses ()
  (dolist (text '("0" "\"0\"" "null" "{}" "\"oops\"" "1.5"))
    (should-error (ths-data--ranking-sina-count text)))
  (should (= 22 (ths-data--ranking-sina-count "\"22\"")))
  (dolist (text '("[]" "null" "{}" "<html>blocked</html>"
                  "[{\"symbol\":\"sh000001\",\"code\":\"000001\",\"name\":\"指数\"}]"
                  "[{\"symbol\":\"sh510300\",\"code\":\"510300\",\"name\":\"ETF\"}]"
                  "[{\"symbol\":\"sz920001\",\"code\":\"920001\",\"name\":\"错误市场\"}]"))
    (should-error (ths-data--ranking-sina-parse text 'change 1 1)))
  (should-error (ths-data--ranking-sina-parse ths-rank-test-sina-response 'amount 1 100))
  (should-not (plist-get (ths-data--ranking-sina-parse "[]" 'amount 2 2) :rows)))

(ert-deftest ths-ranking-empty-eastmoney-falls-back-to-sina-with-server-sort ()
  (dolist (sort '(change amount))
    (let ((ths-data-ranking-providers '(eastmoney sina)) calls callbacks result failure (completed 0))
      (cl-letf (((symbol-function 'ths-data--http)
                 (lambda (url provider cb)
                   (push (cons provider url) calls) (push cb callbacks)
                   (funcall cb (cond ((eq provider 'eastmoney) "{\"data\":{\"total\":0,\"diff\":[]}}")
                                     ((string-match-p "getHQNodeStockCount" url) "\"2\"")
                                     (t ths-rank-test-sina-response)) nil)
                   #'ignore)))
        (ths-data-fetch-ranking sort 1 (lambda (data err) (cl-incf completed) (setq result data failure err)))
        (should-not failure)
        (should (= 4 (length calls)))
        (should (eq 'sina (plist-get result :source)))
        (should (string-match-p (if (eq sort 'amount) "sort=amount&asc=0" "sort=changepercent&asc=0") (cdar calls)))
        (should (string-match-p "page=1&num=20" (cdar calls)))
        (should (equal '(1000000 500000) (mapcar (lambda (row) (plist-get row :amount)) (plist-get result :rows))))
        (dolist (cb callbacks) (funcall cb nil "late failure"))
        (should (= 1 completed))
        (should (= 4 (length calls)))))))

(ert-deftest ths-ranking-sina-cancellation-owns-count-and-data-requests ()
  (dolist (cancel-stage '(count data))
    (let ((ths-data-ranking-providers '(sina)) late cancelled completed (calls 0))
      (cl-letf (((symbol-function 'ths-data--http)
                 (lambda (url _provider cb)
                   (cl-incf calls)
                   (let ((stage (if (string-match-p "getHQNodeStockCount" url) 'count 'data)))
                     (if (eq stage cancel-stage) (setq late cb) (funcall cb "\"2\"" nil))
                     (lambda () (setq cancelled stage))))))
        (let ((cancel (ths-data-fetch-ranking 'amount 1 (lambda (&rest _) (setq completed t)))))
          (funcall cancel)
          (should (eq cancelled cancel-stage))
          (funcall late (if (eq cancel-stage 'count) "\"2\"" ths-rank-test-sina-response) nil)
          (should-not completed)
          (should (= calls (if (eq cancel-stage 'count) 1 2))))))))

(ert-deftest ths-ranking-sina-source-is-shown-and-preserved-when-opening-stock ()
  (ths-test-with-dashboard
    (puthash '(stock change 1) (ths-data--ranking-sina-parse ths-rank-test-sina-response 'change 1 2) ths--rankings)
    (ths-show-ranking)
    (should (ths-test-visible "新浪财经"))
    (should (ths-test-visible "60日涨跌幅暂缺"))
    (ths-test-press 'rank-bj920001)
    (should (eq (plist-get (ths-data-find "920001") :quote-source) 'sina))))

(ert-deftest ths-ranking-request-supports-only-change-and-amount ()
  (let ((change (url-unhex-string (ths-data--ranking-url 'change 1)))
        (amount (ths-data--ranking-url 'amount 2)))
    (should (string-match-p "fid=f3" change))
    (should (string-match-p "fid=f6" amount))
    (should (string-match-p "f21,f24" change))
    (should-not (string-match-p "fid=f5" amount))
    (should (string-match-p "pn=2&pz=20&po=1" amount))
    (dolist (url (list change amount (ths-data--ranking-url 'amount 1 t)))
      (should (string-match-p
               (regexp-quote "&fs=m:0+t:6,m:0+t:80,m:1+t:2,m:1+t:23,m:0+t:81+s:2048&") url)))
    (dolist (fallback '(nil t))
      (should (string-match-p "po=1&np=1&fltt=2&invt=2&fid=f6&" (ths-data--ranking-url 'amount 1 fallback))))
    (should-error (ths-data--ranking-url 'unknown 1))
    (should-error (ths-data--ranking-url 'volume 1))
    (should-error (ths-data--ranking-url 'change 0))))

(ert-deftest ths-ranking-parser-preserves-market-order-units-and-missing-values ()
  (let* ((data (ths-rank-test-data)) (rows (plist-get data :rows)))
    (should (= (plist-get data :total) 3))
    (should (equal (mapcar (lambda (s) (plist-get s :symbol)) rows) '("sh600000" "sz000001" "bj920001")))
    (should (equal (mapcar (lambda (s) (plist-get s :rank)) rows) '(1 2 3)))
    (should (= (plist-get (car rows) :volume) 250000))
    (should (= (plist-get (car rows) :amount) 300000000))
    (should (= (plist-get (car rows) :change) 10.0))
    (should (= (plist-get (car rows) :float-cap) 10000000000))
    (should (= (plist-get (car rows) :change-60d) -12.34))
    (should (= (plist-get (nth 1 rows) :float-cap) 5000000000))
    (should (= (plist-get (nth 1 rows) :change-60d) 0))
    (should-not (plist-get (nth 2 rows) :float-cap))
    (should-not (plist-get (nth 2 rows) :change-60d))
    (should-not (plist-get (nth 2 rows) :price))
    (should-not (plist-get (nth 2 rows) :volume))
    (should (equal "25.00万手" (ths--volume (plist-get (car rows) :volume))))))

(ert-deftest ths-ranking-parser-handles-object-pages-and-invalid-payloads ()
  (let* ((data (ths-data--ranking-parse
                "{\"data\":{\"total\":22,\"diff\":{\"1\":{\"f12\":\"000001\",\"f13\":0,\"f14\":\"B\"},\"0\":{\"f12\":\"600000\",\"f13\":1,\"f14\":\"A\"}}}}"
                'amount 2))
         (rows (plist-get data :rows)))
    (should (equal '("600000" "000001") (mapcar (lambda (s) (plist-get s :code)) rows)))
    (should (equal '(21 22) (mapcar (lambda (s) (plist-get s :rank)) rows))))
  (should-error (ths-data--ranking-parse "{\"data\":{\"total\":0,\"diff\":[]}}" 'change 1))
  (dolist (bad '("<html>blocked</html>" "{\"data\":null}" "{\"data\":{\"total\":100,\"diff\":[]}}"
                 "{\"data\":{\"total\":1,\"diff\":[{\"f12\":\"bad\",\"f13\":1,\"f14\":\"A\"}]}}"))
    (should-error (ths-data--ranking-parse bad 'change 1))))

(ert-deftest ths-ranking-shortcut-buttons-retain-stock-across-toolbar-focus ()
  (ths-test-with-dashboard
    (puthash '(stock change 1) (ths-rank-test-data) ths--rankings)
    (ths-show-ranking)
    (let* ((runtime (etaf-runtime-for-buffer buffer))
           (rows (plist-get (ths--ranking-data (etaf-value ths--state)) :rows))
           (second (nth 1 rows)))
      (ths-next-stock)
      (etaf-focus runtime 'shortcut-j)
      (etaf-activate runtime)
      (should (eq (etaf-focused-host-ref runtime)
                  (intern (concat "rank-" (plist-get second :symbol)))))
      (etaf-focus runtime 'shortcut-RET)
      (etaf-activate runtime)
      (should (eq (plist-get (etaf-value ths--state) :page) 'quotes))
      (should (equal (plist-get (etaf-value ths--state) :selected) (plist-get second :code))))))

(ert-deftest ths-ranking-page-switches-metric-and-retains-quote-selection ()
  (ths-test-with-dashboard
    (ths--set ths--state :selected "688981")
    (puthash '(stock change 1) (ths-rank-test-data) ths--rankings)
    (let ((amount (ths-rank-test-data 'amount)))
      (setq amount (plist-put amount :rows (reverse (plist-get amount :rows))))
      (puthash '(stock amount 1) amount ths--rankings))
    (ths-test-press 'page-ranking)
    (should (ths-test-visible "下一只 j"))
    (should-not (ths-test-visible "同花顺  /  THS"))
    (should-not (ths-test-visible "成交量榜"))
    (should (ths-test-visible "25.00万手"))
    (should-not (ths-test-visible "五档盘口"))
    (ths-test-press 'rank-amount)
    (should (ths-test-visible "成交额排行 / 第 1 页"))
    (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
    (ths-sort)
    (should (eq 'change (plist-get (etaf-value ths--state) :ranking-sort)))
    (ths-sort)
    (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
    (ths--ranking-select ths--state 'volume 2)
    (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
    (should (= 1 (plist-get (etaf-value ths--state) :ranking-page)))
    (ths-test-press 'page-quotes)
    (should (ths-test-visible "五档盘口"))
    (should (equal "688981" (plist-get (etaf-value ths--state) :selected)))))


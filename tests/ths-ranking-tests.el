(ert-deftest ths-ranking-async-requests-are-isolated-and-deduplicated ()
  (ths-test-with-dashboard
    (let (calls callbacks)
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (sort page cb &optional _universe) (push (cons sort page) calls) (push (cons sort cb) callbacks) #'ignore))
                ((symbol-function 'ths-data-fetch) (lambda (&rest _) (ert-fail "Ranking refresh fetched individual quotes"))))
        (ths-show-ranking)
        (ths-refresh)
        (ths-refresh)
        (should (= 1 (length calls)))
        (should (ths-test-visible "正在刷新"))
        (ths-test-press 'rank-amount)
        (ths-refresh)
        (funcall (cdr (assoc 'amount callbacks)) (ths-rank-test-data 'amount) nil)
        (funcall (cdr (assoc 'change callbacks)) (ths-rank-test-data) nil)
        (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
        (should (ths-test-visible "成交额排行 / 第 1 页"))
        (should (= 0 (hash-table-count ths--requests)))
        (ths-refresh)
        (funcall (cdr (car callbacks)) nil "network down")
        (should (ths-test-visible "更新失败，保留上次榜单"))
        (should (ths-test-visible "浦发银行"))))))

(ert-deftest ths-ranking-close-cancels-and-does-not-repopulate-remounted-session ()
  (ths-test-with-dashboard
    (let (callback cancelled)
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (_sort _page cb &optional _universe) (setq callback cb) (lambda () (setq cancelled t)))))
        (ths-show-ranking)
        (ths-refresh)
        (etaf-unmount (etaf-runtime-for-buffer buffer))
        (should cancelled)
        (ths)
        (funcall callback (ths-rank-test-data) nil)
        (should (= 0 (hash-table-count ths--rankings)))))))


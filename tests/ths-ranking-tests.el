(defconst ths-rank-test-mixed-response
  "{\"data\":{\"total\":3,\"diff\":[{\"f12\":\"000001\",\"f13\":1,\"f14\":\"上证指数\",\"f5\":90000000},{\"f12\":\"510300\",\"f13\":1,\"f14\":\"沪深300ETF\",\"f5\":80000000},{\"f12\":\"000001\",\"f13\":0,\"f14\":\"平安银行\",\"f5\":500000}]}}")

(ert-deftest ths-ranking-mixed-universe-is-rejected-without-fabricating-ranks ()
  (dolist (sort '(change amount))
    (should-error (ths-data--ranking-parse ths-rank-test-mixed-response sort 1)
                  :type 'ths-data-ranking-universe-error))
  (dolist (pair '(("510300" . 1) ("159915" . 0) ("399001" . 0)))
    (should-error
     (ths-data--ranking-parse
      (json-encode `((data . ((total . 1) (diff . [((f12 . ,(car pair)) (f13 . ,(cdr pair)) (f14 . "非个股"))])))))
      'amount 1)
     :type 'ths-data-ranking-universe-error)))

(ert-deftest ths-ranking-mixed-page-retries-another-node-and-keeps-real-stock-page ()
  (let (urls result failure callbacks (completed 0))
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (url _provider callback)
                 (push url urls) (push callback callbacks)
                 (funcall callback (if (= (length urls) 1) ths-rank-test-mixed-response ths-rank-test-response) nil)
                 #'ignore)))
      (ths-data-fetch-ranking 'amount 1 (lambda (data err) (cl-incf completed) (setq result data failure err)))
      (should (= 2 (length urls)))
      (should-not (equal (car urls) (cadr urls)))
      (should-not failure)
      (should (= 3 (plist-get result :total)))
      (should (equal '(1 2 3) (mapcar (lambda (s) (plist-get s :rank)) (plist-get result :rows))))
      (should (equal '("sh600000" "sz000001" "bj920001")
                     (mapcar (lambda (s) (plist-get s :symbol)) (plist-get result :rows))))
      ;; Duplicate or late callbacks from either node cannot replace success.
      (dolist (cb callbacks) (funcall cb ths-rank-test-mixed-response nil))
      (should (= 1 completed)))))

(ert-deftest ths-ranking-all-mixed-responses-fail-without-partial-page ()
  (let ((ths-data-ranking-providers '(eastmoney)) result failure (calls 0))
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url _provider callback)
                 (cl-incf calls) (funcall callback ths-rank-test-mixed-response nil) #'ignore)))
      (ths-data-fetch-ranking 'amount 1 (lambda (data err) (setq result data failure err)))
      (should (= 2 calls))
      (should-not result)
      (should (string-match-p "不属于当前类别" failure)))))

(ert-deftest ths-ranking-cancellation-owns-retry-and-ignores-late-response ()
  (let (retry-callback cancelled (calls 0) completed)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url _provider callback)
                 (cl-incf calls)
                 (if (= calls 1)
                     (progn (funcall callback nil "network down") (lambda () (push 'first cancelled)))
                   (setq retry-callback callback)
                   (lambda () (push 'second cancelled))))))
      (let ((cancel (ths-data-fetch-ranking 'amount 1 (lambda (&rest _) (setq completed t)))))
        (funcall cancel)
        (should (equal '(second) cancelled))
        (funcall retry-callback ths-rank-test-response nil)
        (should-not completed)
        (should (= 2 calls))))))

(ert-deftest ths-ranking-old-mixed-cache-is-cleared-even-after-refresh-failure ()

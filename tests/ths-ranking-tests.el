             (list :total 3 :fetched-at (float-time)
                   :rows '((:symbol "sh000001" :code "000001" :name "上证指数" :rank 1)
                           (:symbol "sh510300" :code "510300" :name "沪深300ETF" :rank 2)
                           (:symbol "sz000001" :code "000001" :name "平安银行" :rank 3))) ths--rankings)
    (ths--ranking-select ths--state 'amount)
    (should-not (ths-test-visible "上证指数"))
    (should-not (ths-test-visible "沪深300ETF"))
    (should-not (plist-get (ths--ranking-data (etaf-value ths--state)) :total))
    (cl-letf (((symbol-function 'ths-data-fetch-ranking)
               (lambda (_sort _page cb &optional _universe) (funcall cb nil "network down") #'ignore)))
      (ths-refresh))
    (should-not (ths-test-visible "沪深300ETF"))
    (should (ths-test-visible "获取失败"))
    (ths-test-press 'rank-change)
    (should (ths-test-visible "浦发银行"))
    (should (= 3 (plist-get (ths--ranking-data (etaf-value ths--state)) :total)))))
(defconst ths-rank-test-amount-response
  "{\"data\":{\"total\":2,\"diff\":[{\"f12\":\"600519\",\"f13\":1,\"f14\":\"贵州茅台\",\"f5\":10000,\"f6\":1000000000},{\"f12\":\"000001\",\"f13\":0,\"f14\":\"平安银行\",\"f5\":500000,\"f6\":500000000}]}}")

(ert-deftest ths-ranking-amount-fetch-keeps-server-order-despite-opposite-volume-order ()
  (let (urls result)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (url _provider cb)
                 (push url urls)
                 (if (= 1 (length urls)) (funcall cb nil "network down")
                   (funcall cb ths-rank-test-amount-response nil))
                 #'ignore)))
      (ths-data-fetch-ranking 'amount 1 (lambda (data err) (should-not err) (setq result data))))
    (should (= 2 (length urls)))
    (dolist (url urls) (should (string-match-p "po=1&np=1&fltt=2&invt=2&fid=f6&" url)))
    (let ((rows (plist-get result :rows)))
      (should (equal '("600519" "000001") (mapcar (lambda (s) (plist-get s :code)) rows)))
      (should (> (plist-get (car rows) :amount) (plist-get (cadr rows) :amount)))
      (should (< (plist-get (car rows) :volume) (plist-get (cadr rows) :volume))))))

(ert-deftest ths-ranking-amount-is-isolated-from-late-change-responses ()
  (ths-test-with-dashboard
    (let (callbacks)
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (sort _page cb &optional _universe) (push (cons sort cb) callbacks) #'ignore)))
        (ths-show-ranking)
        (ths-refresh)
        (ths-test-press 'rank-amount)
        (ths-refresh)
        (should (= 2 (length callbacks)))
        (funcall (cdr (assq 'amount callbacks)) (ths-data--ranking-parse ths-rank-test-amount-response 'amount 1) nil)
        (funcall (cdr (assq 'change callbacks)) (ths-rank-test-data) nil)
        (should (eq 'amount (plist-get (etaf-value ths--state) :ranking-sort)))
        (should (ths-test-visible "成交额排行 / 第 1 页"))
        (should (ths-test-visible "贵州茅台"))
        (should (ths-test-visible "10.00亿"))
        (should-not (ths-test-visible "浦发银行"))
        (should (= 0 (hash-table-count ths--requests)))))))

(ert-deftest ths-ranking-amount-stays-visible-at-all-supported-widths-and-pages ()
  (ths-test-with-dashboard
    (let ((data (ths-data--ranking-parse ths-rank-test-amount-response 'amount 1)))
      (puthash '(stock amount 1) (plist-put data :total 21) ths--rankings)
      (puthash '(stock amount 2) '(:total 21 :rows nil) ths--rankings)
      (ths-show-ranking)
      (ths-test-press 'rank-amount)
      (dolist (width '(44 54 55 79 80 90 112 133 160))
        (etaf-runtime-refit (etaf-runtime-for-buffer buffer) width 24)
        (let ((fields (ths--ranking-columns width 'amount)))
          (should (= 1 (cl-count :amount fields :key #'car)))
          (should (<= (apply #'+ (mapcar (lambda (f) (nth 2 f)) fields)) (- width 4))))
        (should (ths-test-visible "成交额榜"))
        (should (ths-test-visible "10.00亿"))
        (should (ths-test-visible "5.00亿"))
        (should (<= (count-lines (point-min) (point-max)) 23)))
      (ths-next-page)
      (should (= 2 (plist-get (etaf-value ths--state) :ranking-page)))
      (ths-test-press 'rank-change)
      (ths-test-press 'rank-amount)
      (should (= 1 (plist-get (etaf-value ths--state) :ranking-page)))
      (should (= 0 (plist-get (etaf-value ths--state) :ranking-offset))))))
(ert-deftest ths-ranking-jk-focuses-highlighted-rows-and-return-opens-stock ()
  (ths-test-with-dashboard
    (puthash '(stock change 1) (ths-rank-test-data) ths--rankings)
    (ths-show-ranking)
    (let ((selected (plist-get (etaf-value ths--state) :selected))
          (runtime (etaf-runtime-for-buffer buffer)))
      (call-interactively (key-binding (kbd "j")))
      (should (eq 'rank-sh600000 (etaf-focused-host-ref runtime)))
      (let* ((pos (etaf-host-ref-position runtime 'rank-sh600000))
             (face (get-text-property pos 'face)))
        (should (member '(:background "#263d60") face)))
      (call-interactively (key-binding (kbd "j")))
      (should (eq 'rank-sz000001 (etaf-focused-host-ref runtime)))
      (call-interactively (key-binding (kbd "k")))
      (should (eq 'rank-sh600000 (etaf-focused-host-ref runtime)))
      (should (equal selected (plist-get (etaf-value ths--state) :selected)))
      ;; TAB and j/k share the same native focus, including RET activation.
      (call-interactively (key-binding (kbd "TAB")))
      (should (eq 'rank-sz000001 (etaf-focused-host-ref runtime)))
      (call-interactively (key-binding (kbd "RET")))
      (should (eq 'quotes (plist-get (etaf-value ths--state) :page)))
      (should (equal "000001" (plist-get (etaf-value ths--state) :selected))))))

(defun ths-rank-test-keyboard-page (page)
  "Return one of two stock pages, totaling 21 stocks, for keyboard tests."
  (list :total 21 :fetched-at (float-time)
        :rows (cl-loop for i from (if (= page 1) 1 21) to (if (= page 1) 20 21)
                       collect (list :symbol (format "sz%06d" i) :code (format "%06d" i)
                                     :name (format "股票%d" i) :rank i :amount (* i 100000)))))

(ert-deftest ths-ranking-jk-crosses-visible-segments-and-server-pages-without-scroll ()
  (ths-test-with-dashboard
    (puthash '(stock amount 1) (ths-rank-test-keyboard-page 1) ths--rankings)
    (puthash '(stock amount 2) (ths-rank-test-keyboard-page 2) ths--rankings)
    (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
    (ths--ranking-select ths--state 'amount)
    (let ((runtime (etaf-runtime-for-buffer buffer)))
      (dotimes (i 21)
        (ths-next-stock)
        (should (eq (intern (format "rank-sz%06d" (1+ i))) (etaf-focused-host-ref runtime)))
        (should (<= (count-lines (point-min) (point-max)) 23)))
      (should (= 2 (plist-get (etaf-value ths--state) :ranking-page)))
      (ths-next-stock)
      (should (eq 'rank-sz000021 (etaf-focused-host-ref runtime)))
      (ths-previous-stock)
      (should (= 1 (plist-get (etaf-value ths--state) :ranking-page)))
      (should (eq 'rank-sz000020 (etaf-focused-host-ref runtime)))
      (dotimes (_ 19) (ths-previous-stock))
      (should (eq 'rank-sz000001 (etaf-focused-host-ref runtime)))
      (ths-previous-stock)
      (should (eq 'rank-sz000001 (etaf-focused-host-ref runtime))))))

(ert-deftest ths-ranking-jk-focuses-new-page-after-async-fetch ()
  (ths-test-with-dashboard
    (puthash '(stock change 1) (ths-rank-test-keyboard-page 1) ths--rankings)
    (ths-show-ranking)
    (etaf-focus (etaf-runtime-for-buffer buffer) 'rank-sz000020)
    (let ((ths-auto-fetch t) callback (calls 0))
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (sort page cb &optional _universe)
                   (should (eq sort 'change)) (should (= page 2))
                   (cl-incf calls) (setq callback cb) #'ignore)))
        (ths-next-stock)
        (should (= 2 (plist-get (etaf-value ths--state) :ranking-page)))
        (ths-next-stock)
        (should (= 1 calls))
        (funcall callback (ths-rank-test-keyboard-page 2) nil)
        (should (eq 'rank-sz000021 (etaf-focused-host-ref (etaf-runtime-for-buffer buffer))))
        (should-not ths--ranking-pending-focus)))))

(ert-deftest ths-ranking-jk-late-page-cannot-steal-focus-after-switching-metric ()
  (ths-test-with-dashboard
    (puthash '(stock change 1) (ths-rank-test-keyboard-page 1) ths--rankings)
    (puthash '(stock amount 1) (ths-data--ranking-parse ths-rank-test-amount-response 'amount 1) ths--rankings)
    (ths-show-ranking)
    (etaf-focus (etaf-runtime-for-buffer buffer) 'rank-sz000020)
    (let ((ths-auto-fetch t) callback)
      (cl-letf (((symbol-function 'ths-data-fetch-ranking)
                 (lambda (_sort _page cb &optional _universe) (setq callback cb) #'ignore)))
        (ths-next-stock)
        (ths-test-press 'rank-amount)
        (ths-next-stock)
        (should (eq 'rank-sh600519 (etaf-focused-host-ref (etaf-runtime-for-buffer buffer))))
        (funcall callback (ths-rank-test-keyboard-page 2) nil)
        (should (eq 'rank-sh600519 (etaf-focused-host-ref (etaf-runtime-for-buffer buffer))))
        (should-not ths--ranking-pending-focus)))))

(ert-deftest ths-ranking-jk-empty-or-failed-page-does-not-move-quote-selection ()
  (ths-test-with-dashboard
    (let ((selected (plist-get (etaf-value ths--state) :selected)))
      (ths-show-ranking)
      (ths-next-stock)
      (ths-previous-stock)
      (should (equal selected (plist-get (etaf-value ths--state) :selected)))
      (puthash '(stock change 1) (ths-rank-test-keyboard-page 1) ths--rankings)
      (ths--publish)
      (etaf-focus (etaf-runtime-for-buffer buffer) 'rank-sz000020)
      (let ((ths-auto-fetch t))

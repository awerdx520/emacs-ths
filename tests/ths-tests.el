;;; ths-tests.el --- THS public runtime acceptance tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)
;; Never read or overwrite the user's saved watchlist during batch tests.
(setq ths-watchlist-file nil)
(load (expand-file-name "ths-fixtures.el" (file-name-directory load-file-name)) nil t)

(defmacro ths-test-with-dashboard (&rest body)
  "Run BODY inside a fresh real ETAF dashboard."
  (declare (indent 0))
  `(let* ((ths-auto-fetch nil) (ths-buffer-name " *ths-test*") (buffer (ths)))
     (unwind-protect (with-current-buffer buffer
                       (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 160 60)
                       (setq ths-data-stocks (ths-test-stocks))
                       (ths--publish)
                       ,@body)
       (when (buffer-live-p buffer) (kill-buffer buffer)))))

(defun ths-test-press (ref)
  "Activate REF through the public ETAF event path."
  (etaf-dispatch-event (etaf-runtime-for-buffer (current-buffer)) ref 'press))

(defun ths-test-visible (text)
  "Return non-nil when rendered buffer contains TEXT."
  (string-match-p (regexp-quote text) (buffer-string)))

(ert-deftest ths-mount-renders-real-etaf-dashboard ()
  (ths-test-with-dashboard
   (should (etaf-runtime-mounted-p (etaf-runtime-for-buffer buffer)))
   (should-not (ths-test-visible "同花顺  /  THS"))
   (dolist (text '("分时走势" "五档盘口" "卖5" "买5" "173.88"))
     (should (ths-test-visible text)))
   (should buffer-read-only)
   (should (eq (key-binding (kbd "j")) #'ths-next-stock))
   (should (eq (key-binding (kbd "/")) #'ths-search))
   (should (eq buffer (ths)))))

(ert-deftest ths-stock-event-updates-quote-chart-and-book ()
  (ths-test-with-dashboard
   (let ((before (buffer-string)))
     (ths-test-press 'stock-600519)
     (should (equal "600519" (plist-get (etaf-value ths--state) :selected)))
     (should (ths-test-visible "贵州茅台  600519"))
     (should (ths-test-visible "-14.80"))
     (should (ths-test-visible "1465.25"))
     (should-not (equal before (buffer-string))))))

(ert-deftest ths-chart-buttons-update-rendered-content ()
  (ths-test-with-dashboard
   (ths-test-press 'daily)
   (should (ths-test-visible "不复权"))
   (should (ths-test-visible "┃"))
   (should-not (ths-test-visible "分时走势"))
   (ths-test-press 'intraday)
   (should (ths-test-visible "分时走势"))))

(ert-deftest ths-filter-search-empty-and-recovery ()
  (ths-test-with-dashboard
   (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "半导体")))
     (ths-test-press 'shortcut-/))
   (should (equal "688981" (plist-get (etaf-value ths--state) :selected)))
   (should (ths-test-visible "1 支"))
   (ths--set ths--state :query "不存在")
   (should (ths-test-visible "没有匹配股票"))
   (should-not (plist-get (etaf-value ths--state) :selected))
   (ths-next-stock)
   (ths-toggle-favorite)
   (ths-test-press 'clear-search)
   (should (ths-test-visible "8 支"))
   (should (equal "300033" (plist-get (etaf-value ths--state) :selected)))))

(ert-deftest ths-watchlist-removal-maintains-valid-selection ()
  (ths-test-with-dashboard
   (ths-test-press 'favorites)
   (should (ths-test-visible "3 支"))
   (dotimes (_ 3) (ths-test-press 'favorite-toggle))
   (should (ths-test-visible "暂无自选"))
   (should-not (plist-get (etaf-value ths--state) :favorites))
   (ths-test-press 'all)
   (ths-test-press 'favorite-toggle)
   (ths-test-press 'favorites)
   (should (ths-test-visible "1 支"))))

(ert-deftest ths-sort-and-keyboard-selection-agree ()
  (ths-test-with-dashboard
   (ths-test-press 'sort)
   (let ((stocks (ths--stocks (etaf-value ths--state))))
     (should (equal (plist-get (car stocks) :code) "688981")))
   (ths--set ths--state :selected "688981")
   (call-interactively (key-binding (kbd "j")))
   (should (equal "300059" (plist-get (etaf-value ths--state) :selected)))
   (call-interactively (key-binding (kbd "k")))
   (should (equal "688981" (plist-get (etaf-value ths--state) :selected)))))

(ert-deftest ths-focus-activation-uses-native-etaf-path ()
  (ths-test-with-dashboard
   (let ((runtime (etaf-runtime-for-buffer buffer)))
     (etaf-focus runtime 'daily)
     (should (eq (etaf-focused-host-ref runtime) 'daily))
     (etaf-activate runtime)
     (should (ths-test-visible "不复权")))))

(ert-deftest ths-wide-layout-and-refit-retain-state ()
  (ths-test-with-dashboard
   (ths-test-press 'stock-688981)
   (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 1500 50)
   (should (ths-test-visible "五档盘口"))
   (should (ths-test-visible "中芯国际  688981"))
   (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
   (should (<= (count-lines (point-min) (point-max)) 24))
   (should (ths-test-visible "中芯国际  688981"))
   (ths--section 'list)
   (should (ths-test-visible "行情列表"))
   (should (equal "688981" (plist-get (etaf-value ths--state) :selected)))))

(ert-deftest ths-svg-has-connected-price-and-mean-paths ()
  (require 'xml)
  (dolist (stock (ths-test-stocks))
    (with-temp-buffer
      (insert (ths-chart-svg stock))
      (let* ((root (car (xml-parse-region (point-min) (point-max))))
             (group (car (xml-get-children root 'g)))
             (paths (xml-get-children group 'path)))
        (dolist (id '("price-line" "mean-line"))
          (let* ((path (seq-find (lambda (p) (equal (xml-get-attribute p 'id) id)) paths))
                 (data (xml-get-attribute path 'd)))
            (should (string-prefix-p "M" data))
            (should (= 240 (cl-count ?L data)))
            (should (equal (xml-get-attribute path 'fill) "none"))))))))

(ert-deftest ths-unmount-cleans-runtime ()
  (let* ((ths-auto-fetch nil) (ths-buffer-name " *ths-cleanup*") (buffer (ths))
         (runtime (etaf-runtime-for-buffer buffer)))
    (kill-buffer buffer)
    (should-not (etaf-runtime-mounted-p runtime))
    (should-not (etaf-runtime-for-buffer buffer))))

(ert-deftest ths-fixture-charts-and-book-have-consistent-bounds ()
  (dolist (stock (ths-test-stocks))
    (should (< (abs (- (car (last (ths-data-series stock))) (plist-get stock :price))) 0.000001))
    (dolist (candle (ths-data-candles stock))
      (should (>= (plist-get candle :high) (max (plist-get candle :open) (plist-get candle :close))))
      (should (<= (plist-get candle :low) (min (plist-get candle :open) (plist-get candle :close)))))
    (should (= 10 (length (ths-data-book stock))))
    (dolist (chart (list (ths-chart-line stock) (ths-chart-candles stock)))
      (let ((lines (split-string chart "\n")))
        (should (= 12 (length lines)))
        (should (cl-every (lambda (line) (= (string-width line) 58)) lines))))))
(defun ths-test-daily-svg-group (candles &optional count)
  "Parse the chart group for CANDLES, limited to COUNT."
  (with-temp-buffer
    (insert (ths-chart-candles-svg (list :candles candles) count))
    (car (xml-get-children (car (xml-parse-region (point-min) (point-max))) 'g))))

(ert-deftest ths-daily-svg-aligns-bodies-wicks-and-colors ()
  (let* ((candles '((:date "2026-10-14" :open 10 :close 12 :high 13 :low 9)
                    (:date "2026-10-15" :open 12 :close 11 :high 14 :low 10)))
         (group (ths-test-daily-svg-group candles))
         (bars (seq-filter (lambda (g) (equal (xml-get-attribute g 'class) "candle")) (xml-get-children group 'g))))
    (should (= 2 (length bars)))
    (cl-loop for bar in bars for color in (list (ths-theme-color 'up) (ths-theme-color 'down))
             do (let* ((wick (car (xml-get-children bar 'line)))
                       (body (car (xml-get-children bar 'rect)))
                       (x (string-to-number (xml-get-attribute body 'x)))
                       (width (string-to-number (xml-get-attribute body 'width)))
                       (y (string-to-number (xml-get-attribute body 'y)))
                       (height (string-to-number (xml-get-attribute body 'height))))
                  (should (equal color (xml-get-attribute body 'fill)))
                  (should (= (+ x (/ width 2.0)) (string-to-number (xml-get-attribute wick 'x1))))
                  (should (equal (xml-get-attribute wick 'x1) (xml-get-attribute wick 'x2)))
                  (should (<= 76 x (+ x width) 700))
                  (should (<= 26 (string-to-number (xml-get-attribute wick 'y1))
                              y (+ y height) (string-to-number (xml-get-attribute wick 'y2)) 210))))))

(ert-deftest ths-daily-svg-handles-flat-single-candle-and-empty-history ()
  (should-not (ths-chart-candles-svg nil))
  (let* ((group (ths-test-daily-svg-group '((:date "2026-10-16" :open 10 :close 10 :high 10 :low 10))))
         (bar (car (xml-get-children group 'g)))
         (lines (xml-get-children bar 'line))
         (dates (seq-filter (lambda (node) (equal (xml-get-attribute node 'class) "date-label"))
                            (xml-get-children group 'text))))
    (should (= 2 (length lines)))
    (should-not (xml-get-children bar 'rect))
    (should (equal (xml-get-attribute (cadr lines) 'y1) (xml-get-attribute (cadr lines) 'y2)))
    (should (= 1 (length dates)))
    (should (equal (xml-get-attribute (car dates) 'text-anchor) "middle"))))

(ert-deftest ths-daily-svg-limits-bars-and-escapes-date-labels ()
  (let* ((candles '((:date "old" :open 10 :close 11 :high 12 :low 9)
                    (:date "2026-10-15" :open 10 :close 11 :high 12 :low 9)
                    (:date "<date & \"text\">" :open 11 :close 10 :high 12 :low 9)))
         (group (ths-test-daily-svg-group candles 2))
         (bars (seq-filter (lambda (g) (equal (xml-get-attribute g 'class) "candle")) (xml-get-children group 'g))))
    (should (= 2 (length bars)))
    (should (equal "2026-10-15" (xml-get-attribute (car bars) 'data-date)))
    (should (equal "<date & \"text\">" (xml-get-attribute (cadr bars) 'data-date)))))
;;; ths-tests.el ends here
